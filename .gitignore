# -----------------------------------------------------------------------------
# Repo root doubles as the west workspace root. `west update` pulls the
# following trees in as siblings of `updater/` — all ignored here.
# -----------------------------------------------------------------------------
# Anchored with a leading slash: these names also occur *inside* our own
# tree (updater/modules/ holds in-tree Zephyr modules, and any Zephyr module
# has a zephyr/ subdirectory holding its module.yml). Unanchored, git
# silently ignored those too.
/.west/
/zephyr/
/modules/
/bootloader/
/tools/
/nrf/
/nrfxlib/
# test/cmock — pulled transitively (it's in no local west.yml, only `west list`).
# Everything under this root-level test/ belongs to west; our own tests live in
# web/test/.
/test/

# Zephyr / west build trees (in-tree or per-app)
build/
build_*/
updater/build/
updater/build_*/

# Toolchain-manager pyc caches
__pycache__/
*.pyc

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# Claude
.claude/
CLAUDE.md
# CLAUDE.md's detail, split out of it so it is not read on every exchange.
notes/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# Web client: generated single-file build + on-demand test deps.
# web/vendor/ is deliberately NOT ignored — Vue is vendored on purpose.
web/dist/
node_modules/

# Occasional stray artifacts
*.hex
*.bin
*.elf
*.uf2
*.map
# Serial captures. Kept locally on purpose — a boot log is the only record of
# what a board actually said, and one from before a rename reads as a stale
# find in `grep -r` while being the one file that must not be rewritten.
bootlog_*.log

# Staged by web/tools/stage-firmware.mjs for local testing, and by
# .github/workflows/web.yml at deploy time. Never committed: the real
# copy comes from a release, and a stale hex sitting next to the sources
# is one anybody could flash by pressing "Flash newest".
web/firmware/

# esptool >= 5.0.2 for Espressif builds; build.sh creates it (see ensure_esptool).
.venv-esptool/
