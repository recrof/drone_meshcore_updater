/*
 * Application-level device-tree overlay.
 *
 * Seeed's vendored board file defines the on-board PY25Q64H QSPI flash
 * (as `py25q64` on `spi00`) but ships it `status = "disabled"` with no
 * partitions. We flip it on and reserve the entire 8 MiB as a single
 * LittleFS partition — same layout intent as the CONFIG.TXT / firmware /
 * LOG.TXT storage on the nRF52 sibling project, just implemented as a
 * proper filesystem instead of a manually-written FAT12 image.
 */

/ {
	fstab {
		compatible = "zephyr,fstab";

		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			/* Mount point intentionally matches the DT node label
			 * `lfs1` — nRF Connect Device Manager defaults its
			 * upload/download destination to `/<label>/`, so
			 * keeping them aligned means the app's default paths
			 * "just work" and users don't have to hand-type
			 * `/lfs/` every time.
			 */
			mount-point = "/lfs1";
			partition = <&lfs_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&py25q64 {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		lfs_partition: partition@0 {
			label = "littlefs_storage";
			reg = <0x00000000 DT_SIZE_M(8)>;
		};
	};
};

/*
 * LED polarity fix.
 *
 * Seeed's vendored board files declare all three LEDs GPIO_ACTIVE_HIGH, and
 * the matching pwmleds nodes PWM_POLARITY_NORMAL. Both are inverted: the XIAO
 * RGB LED is common-anode, so the pin sinks and physical LOW is lit. Every
 * other XIAO in the Zephyr tree agrees — xiao_ble and xiao_nrf54l15 both use
 * GPIO_ACTIVE_LOW (and xiao_ble uses PWM_POLARITY_INVERTED). The same error
 * made twice in one file reads as a copy-paste slip, not a hardware
 * difference, and it is the second thing found wrong in these vendored files
 * after the openocd RRAM commit bug.
 *
 * Symptom it caused: led.c writes are mutually exclusive, but inverted they
 * came out as "red and blue solid, green flickering between them" during DFU,
 * and DONE_OK rendered as magenta rather than solid green.
 *
 * Overridden here rather than in the board file so a board refresh cannot
 * quietly undo it.
 */
&blue_led {
	gpios = <&gpio1 23 GPIO_ACTIVE_LOW>;
};

&red_led {
	gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;
};

&green_led {
	gpios = <&gpio1 24 GPIO_ACTIVE_LOW>;
};
