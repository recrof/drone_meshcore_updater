# SPDX-License-Identifier: Apache-2.0

if BOARD_HELTEC_WIFI_LORA32_V4_ESP32S3_PROCPU

# The OLED sits behind the Vext load switch, modelled as a GPIO power domain.
# Not in MCUboot: it is built single-threaded, and power_domain_gpio.c calls
# k_can_yield(), which then does not link.
config POWER_DOMAIN
	default y if !MCUBOOT

config POWER_DOMAIN_GPIO
	default y if !MCUBOOT

if LVGL

config LV_Z_VDB_SIZE
	default 64

config LV_DPI_DEF
	default 116

config LV_Z_COLOR_MONO_HW_INVERSION
	default y

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # BOARD_HELTEC_WIFI_LORA32_V4_ESP32S3_PROCPU
